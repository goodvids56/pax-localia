{
  "name": "pax-localia",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first alternate-history and geopolitical sandbox",
  "license": "GPL-3.0-or-later",
  "author": "Pax Localia contributors",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @pax-localia/desktop start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate-content.ts",
    "build": "pnpm --filter @pax-localia/desktop package",
    "package": "pnpm --filter @pax-localia/desktop package",
    "make": "pnpm --filter @pax-localia/desktop make",
    "postinstall": "pnpm --filter @pax-localia/desktop exec electron-forge install-app-deps",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
