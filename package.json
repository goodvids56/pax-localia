{
  "name": "pax-localia",
  "productName": "Pax Localia",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first alternate-history and geopolitical sandbox",
  "license": "GPL-3.0-or-later",
  "author": "Pax Localia contributors",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "electron-forge start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/run-electron-vitest.mjs",
    "test:e2e": "cross-env PAX_LOCALIA_E2E_PACKAGE=1 pnpm package && cross-env PAX_LOCALIA_E2E_USE_PACKAGED=1 playwright test",
    "test:lmstudio": "tsx scripts/test-local-provider.ts --provider=lm-studio",
    "test:ollama": "tsx scripts/test-local-provider.ts --provider=ollama",
    "validate": "tsx scripts/validate-content.ts",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "lodash": "^4.18.1",
    "macos-alias": "^0.2.12",
    "playwright": "^1.61.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
